# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (matches docker-compose.yml's port 5433 mapping,
# chosen to avoid colliding with a Postgres instance you might already have
# running locally on the default 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/customer_support

# Groq API key used by the Vercel AI SDK (@ai-sdk/groq). Get a free key
# (no card required) at https://console.groq.com/keys.
# Not required if MOCK_LLM=true below.
GROQ_API_KEY=

# DEV ONLY: set to "true" to run without GROQ_API_KEY, using a
# keyword-based mock router + templated agent replies instead of real
# model calls. Real DB tool queries and persistence still happen. See README.
MOCK_LLM=false

# Any long random string - used to sign/verify JWTs
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
